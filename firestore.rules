rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function getCedulaForUid() {
      return isAuthenticated() && exists(/databases/$(database)/documents/uid_cedula/$(request.auth.uid))
          ? get(/databases/$(database)/documents/uid_cedula/$(request.auth.uid)).data.cedula
          : null;
    }

    function isPlatformAdmin() {
      return isAuthenticated() && getUserData().rol == 'administrador_plataforma';
    }

    function isAdminOrPlatform() {
      return isAuthenticated() && [
        'admin',
        'administrador_plataforma',
        'administracion_general',
        'admin_general',
        'administracion'
      ].hasAny([getUserData().rol]);
    }

    // Roles autorizados para asignar/quitar roles a otros usuarios.
    // ✅ Definido por el administrador: admin_plataforma, admin_general, filial, académico, administrativo.
    function canAssignRoles() {
      return isAuthenticated() && [
        'admin',
        'administrador_plataforma',
        'administracion_general',
        'admin_general',
        'administracion',
        'administrativo',
        'academico',
        'admin_filial'
      ].hasAny([getUserData().rol]);
    }

    function isAcademico() {
      return isAuthenticated() && getUserData().rol == 'academico';
    }

    function isDocente() {
      return isAuthenticated() && getUserData().rol == 'docente';
    }

    function isAdminFilial() {
      return isAuthenticated() && getUserData().rol == 'admin_filial';
    }


    function isStaff() {
      return isAuthenticated() && [
        'admin',
        'administrador_plataforma',
        'administracion_general',
        'admin_general',
        'administracion',
        'academico',
        'academic',
        'docente',
        'admin_filial',
        'asistencia_estudiante'
      ].hasAny([getUserData().rol]);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Mapeo uid → cédula (escrito por el login cuando Firebase Auth anónimo está activo) ──
    // Permite que las reglas de lectura de cada alumno se resuelvan por CÉDULA (getCedulaForUid()),
    // comparando contra resource.data.cedula en notas, pagos, asistencia, consultas, etc.
    match /uid_cedula/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    match /usuarios/{userId} {
      // Lectura autenticada (propietario, el alumno por su cédula, o staff)
      allow read: if isAuthenticated() && (isOwner(userId) || getCedulaForUid() == resource.data.cedula || isStaff());

      // 🔒 Login bootstrap SIN auth: SOLO query filtrada por cédula y con LIMIT 1.
      // Prohibida la lectura de la colección completa o por ID sin autenticación.
      // Con auth (anónima/real): scans puntuales por rol o es_docente para gestión docente (limit<=500).
      allow list: if request.query.where.size() == 1
                  && request.query.limit <= 500
                  && (
                      (request.query.where[0].field == 'cedula' && request.query.limit <= 1)
                      || (isAuthenticated()
                          && (request.query.where[0].field == 'rol'
                              || request.query.where[0].field == 'es_docente'))
                  );

      // Cambio de contraseña SIN auth (login provisorio → definitiva):
      // exige current_password == password actual (prueba de identidad) y solo permite
      // tocar password/updated_at/must_change_password/current_password sin cambiar cedula.
      // Un segundo update (sin auth) permite borrar el campo current_password del doc.
      // Gestión docente (académico/admin) con auth: permite tocar SOLO claves de asignación,
      // sin cambiar cedula ni password.
      // Actualización de perfil: el propio usuario (por getCedulaForUid) o un admin.
      allow update: if isAuthenticated() && (isOwner(userId) || getCedulaForUid() == resource.data.cedula || isAdminOrPlatform())
                 || (request.auth == null
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password','updated_at','must_change_password','current_password'])
                     && request.resource.data.cedula == resource.data.cedula
                     && request.resource.data.current_password == resource.data.password)
                 || (request.auth == null
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current_password'])
                     && !('current_password' in request.resource.data))
                 // Gestión de roles: solo roles autorizados pueden tocar rol/roles/estado.
                 // canAssignRoles() = admin, administrador_plataforma, administracion_general,
                 //                    administrativo, academico, admin_filial.
                 || (canAssignRoles()
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol','estado','roles','es_docente','asignaciones','updated_at'])
                     && request.resource.data.cedula == resource.data.cedula
                     && request.resource.data.password == resource.data.password);
      allow create: if isAuthenticated() && (isOwner(userId) || isAdminOrPlatform());
      allow delete: if isAdminOrPlatform();

      match /roles/{rolId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isStaff());
        allow write: if canAssignRoles();   // académico, filial, administrativo también pueden
      }

    }

    match /asignaturas/{asigId} {
      // Catálogo público: necesario para cargar "Mis Cursos" cuando Firebase Auth anónimo
      // no está habilitado. Las escrituras siguen restringidas al staff.
      allow read: if true;
      allow create, update: if isAuthenticated() && (
        isAdminOrPlatform() || isAcademico() || isDocente() || isAdminFilial()
      );
      allow delete: if isAdminOrPlatform();
    }

    match /notas/{notaId} {
      allow read: if isAuthenticated() && (getCedulaForUid() == resource.data.cedula || isStaff());
      allow create, update: if isAuthenticated() && (
        isAdminOrPlatform() || isAcademico() || isDocente()
      );
      allow delete: if isAdminOrPlatform();
    }

    match /asistencia/{asistId} {
      allow read: if isAuthenticated() && (getCedulaForUid() == resource.data.cedula || isStaff());
      allow create, update: if isAuthenticated() && (
        isAdminOrPlatform() || isAcademico() || isDocente()
      );
      allow delete: if isAdminOrPlatform();
    }

    match /eventos/{eventoId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (
        isAdminOrPlatform() || isAcademico() || isDocente()
      );
      allow delete: if isAuthenticated() && (
        isAdminOrPlatform() || isAcademico() ||
        (isDocente() && resource.data.creado_por == getUserData().cedula)
      );
    }

    match /formularios/{formId} {
      allow read: if isAuthenticated() && (
        getCedulaForUid() == resource.data.cedula_alumno || isAdminOrPlatform() || isAcademico()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdminOrPlatform();
    }

    match /pagos/{pagoId} {
      allow read: if isAuthenticated() && (
        getCedulaForUid() == resource.data.cedula || isStaff()
      );
      // Verificación de factura del examen (módulo de exámenes): query pública SOLO por cédula, con límite.
      allow list: if request.query.where.size() == 1
                  && request.query.limit <= 20
                  && request.query.where[0].field == 'cedula';
      allow create, update: if isAuthenticated() && (isAdminOrPlatform() || isAcademico());
      allow delete: if isAdminOrPlatform();
    }

    match /solicitudes_docentes/{solId} {
      allow read: if isAuthenticated() && (isAdminOrPlatform() || isOwner(solId));
      allow create: if isAuthenticated();
      allow update: if isAdminOrPlatform();
      allow delete: if false;
    }

    match /configuracion/{configId} {
      allow read: if isAuthenticated() && isStaff();
      allow write: if isAdminOrPlatform();
    }

    match /filiales/{filialId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin();
    }

     match /calendar_events/{eventId} {
       allow read: if isAuthenticated();
       allow write: if isAuthenticated() && isStaff();
     }

     // ═══ NUEVAS COLECCIONES ═══

     match /examenes/{examId} {
       allow read: if isAuthenticated();
       allow create, update: if isAuthenticated() && (isAdminOrPlatform() || isAcademico());
       allow delete: if isAdminOrPlatform();
     }

     match /consultas/{conId} {
       allow read: if isAuthenticated() && (getCedulaForUid() == resource.data.alumno_cedula || isAdminOrPlatform() || isAcademico());
       allow create: if isAuthenticated();
       allow update: if isAuthenticated() && (isAdminOrPlatform() || getCedulaForUid() == resource.data.alumno_cedula);
     }

     match /mensajes/{msgId} {
       allow read: if isAuthenticated() && (getCedulaForUid() == resource.data.destinatario || isStaff());
       allow create: if isAuthenticated();
       allow delete: if isAuthenticated() && getCedulaForUid() == resource.data.destinatario;
     }

     match /credenciales/{credId} {
       allow read: if isAuthenticated();
       allow create: if isAuthenticated();
       allow update: if isAuthenticated() && isStaff();
       allow delete: if isAdminOrPlatform();
     }

     match /borradores/{brwId} {
       allow read: if isAuthenticated();
       allow create: if isAuthenticated() && isStaff();
       allow update: if isAuthenticated() && (isAdminOrPlatform() || isAcademico() || isDocente());
       allow delete: if isAdminOrPlatform();
     }

     match /cursos/{curId} {
      allow read: if true;
      allow write: if isAuthenticated() && isStaff();
    }

     // Intentos/resultados de exámenes por alumno (doc por examen + cédula: "examen__cedula").
     // La lectura es pública (requerida para el historial del alumno mientras no exista
     // Firebase Auth anónimo). La escritura se limita a que la cédula del documento coincida
     // con la cédula del ID, evitando que un alumno sobrescriba las de otro.
     match /intentos/{intentoId} {
       allow read: if true;
       allow create, update: if request.resource.data.alumno_cedula == intentoId.split('__')[1];
       allow delete: if false;
     }

     // Módulo de exámenes: configuración (ventana/intentos), aprobación académica, código y
     // solicitudes de acceso por factura. Lectura pública (el gate exam-lock la consulta sin
     // auth). Escritura abierta mientras no exista Firebase Auth anónimo para poder
     // autenticar docentes/académicos en el servidor (mismo modelo pseudo-token de la app).
     match /config_examen/{cfgId} {
       allow read: if true;
       allow write: if true;
     }
     match /aprobacion_examen/{apId} {
       allow read: if true;
       allow write: if true;
     }
     match /codigo_examen/{codId} {
       allow read: if true;
       allow write: if true;
     }
     match /acceso_examen/{accId} {
       allow read: if true;
       allow write: if true;
     }
   }
 }