rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ══════════════════════════════════════
    // FOTOS DE PERFIL
    // ══════════════════════════════════════
    match /fotos_perfil/{userId}/{allPaths=**} {
      // Lectura: cualquiera autenticado
      allow read: if request.auth != null;

      // Escritura: solo el propio usuario o admin
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(firestore.root)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'
      );

      // Validar tipo de archivo
      allow write: if request.resource.contentType.matches('image/.*');
      
      // Limitar tamaño a 5MB
      allow write: if request.resource.size < 5 * 1024 * 1024;
    }

    // ══════════════════════════════════════
    // MATERIALES / DOCUMENTOS
    // ══════════════════════════════════════
    match /materiales/{asignaturaId}/{allPaths=**} {
      // Lectura: todos los autenticados
      allow read: if request.auth != null;

      // Escritura: docente asignado o admin
      allow write: if request.auth != null && (
        get(/databases/$(firestore.root)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
        get(/databases/$(firestore.root)/documents/usuarios/$(request.auth.uid)).data.rol == 'docente'
      );
    }

    // ══════════════════════════════════════
    // COMPROBANTES DE PAGO
    // ══════════════════════════════════════
    match /comprobantes/{userId}/{allPaths=**} {
      // Lectura: el propio usuario o admin
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(firestore.root)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'
      );

      // Escritura: el propio usuario
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
